{
  "expo": {
    "name": "Анамнез",
    "slug": "anamnez",
    "scheme": "anamnez",
    "version": "0.3.26",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F3EEE3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "games.gornitsa.anamnez"
    },
    "android": {
      "package": "games.gornitsa.anamnez",
      "versionCode": 91,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#1A8A86"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "com.google.android.gms.permission.AD_ID",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PT Serif",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PTSerif-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/PTSerif-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/PTSerif-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PT Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PTSans-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/PTSans-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PT Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PTMono-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Golos Text",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GolosText-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/GolosText-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/GolosText-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/GolosText-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PTSerif-Regular.ttf",
              "./assets/fonts/PTSerif-Italic.ttf",
              "./assets/fonts/PTSerif-Bold.ttf",
              "./assets/fonts/PTSans-Regular.ttf",
              "./assets/fonts/PTSans-Bold.ttf",
              "./assets/fonts/PTMono-Regular.ttf",
              "./assets/fonts/GolosText-Regular.ttf",
              "./assets/fonts/GolosText-Medium.ttf",
              "./assets/fonts/GolosText-SemiBold.ttf",
              "./assets/fonts/GolosText-Bold.ttf",
              "./assets/fonts/JetBrainsMono-Medium.ttf",
              "./assets/fonts/JetBrainsMono-Bold.ttf"
            ]
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-release-no-internet"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
