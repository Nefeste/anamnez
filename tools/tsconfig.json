{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/engine/**/*.ts",
    "../src/content/types.ts",
    "../src/render/ecgSignal.ts",
    "../src/state/saves.ts"
  ],
  "exclude": [
    "./e2e/**"
  ]
}
